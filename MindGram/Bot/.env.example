# Bot token from @BotFather (only in /opt/mindgram-bot/.env on the server, never in git)
BOT_TOKEN=
# Local Bot API server (deploy/bot-api.sh); lets the bot send IPA files up to 2000 MB
API_SERVER=http://127.0.0.1:8111
# Command that unlocks the bot for a user
ACTIVATE_COMMAND=aftreen
TIMEZONE=Europe/Moscow
